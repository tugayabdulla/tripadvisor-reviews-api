[Unit]
Description=TripAdvisor Reviews API
After=network.target postgresql.service

[Service]
WorkingDirectory=/data/tripadvisor/api
EnvironmentFile=/data/tripadvisor/api/.env
ExecStart=/data/tripadvisor/api/.venv/bin/gunicorn app.main:app -k uvicorn.workers.UvicornWorker -w 4 -b 127.0.0.1:8000 --timeout 60
Restart=always
User=root

[Install]
WantedBy=multi-user.target
